# Copy to .env and fill in the secret values before starting the app.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-random-secret-before-deployment
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=paste-generated-fernet-key-here
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=0
OPERATIONAL_DB_PATH=data/operational/meshkor.sqlite3
IA_DATA_ROOT=
